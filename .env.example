# Intelligence artificielle côté serveur via xKiro.
XKIRO_API_KEY=

# Secrets de la connexion Google. Ne jamais les publier dans Git.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_GOOGLE_EMAIL=

# Identité publique affichée sur les pages légales requises par Google OAuth.
LEGAL_NAME=
SUPPORT_EMAIL=

# Persistance des préférences, règles, envois programmés et rappels.
DATABASE_URL=
# Utiliser "disable" uniquement pour une base PostgreSQL locale sans TLS.
POSTGRES_SSL=require

# Chiffrement AES-GCM du jeton de renouvellement Google stocké en base.
DATA_ENCRYPTION_SECRET=

# Synchronisation Gmail permanente via Google Cloud Pub/Sub.
GMAIL_PUBSUB_TOPIC=projects/votre-projet/topics/gmail-mailbox-events
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# Appels protégés de la tâche périodique Priorité 0.
CRON_SECRET=

# Notifications Web Push. La clé publique est volontairement exposée au navigateur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
